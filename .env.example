# ============================================================================
# Caetano Auto CRM — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione valores reais.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (convites de usuário, API externa, webhooks). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de convite, recuperação de senha, webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail do dono para o script de criação do primeiro acesso (pnpm criar-dono)
OWNER_EMAIL=

# --- Tabela FIPE (gratuita, sem conta) -------------------------------------
# brasilapi (padrão) ou parallelum
FIPE_PROVIDER=brasilapi
# Opcional: token da Parallelum v2 para limites maiores
FIPE_TOKEN=

# --- IA (API do Claude) ----------------------------------------------------
# Sem chave, o sistema usa o modo simulado.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# --- Fiscal (NF-e) -----------------------------------------------------------
# mock (padrão, não emite nada) | focusnfe | nfeio
FISCAL_PROVIDER=mock
FISCAL_API_TOKEN=
# homologacao | producao
FISCAL_AMBIENTE=homologacao
# Somente NFE.io: id da empresa no provedor
FISCAL_EMPRESA_ID=

# --- Open Finance ------------------------------------------------------------
# none (padrão) | pluggy
OPEN_FINANCE_PROVIDER=none
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- API interna, webhooks e tarefas agendadas -----------------------------
# Segredo para o hash das chaves de API (gere com: openssl rand -hex 32)
API_KEY_PEPPER=
# Segredo das rotas /api/cron/* (gere com: openssl rand -hex 32)
CRON_SECRET=
