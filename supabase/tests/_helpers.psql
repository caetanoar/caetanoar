-- Helpers dos testes pgTAP (incluídos com \ir em cada arquivo de teste).
create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

create or replace function pg_temp.criar_usuario(p_email text, p_papel text, p_ativo boolean default true)
returns uuid language plpgsql as $$
declare v_id uuid := gen_random_uuid();
begin
  insert into auth.users (instance_id, id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', v_id, 'authenticated', 'authenticated', p_email,
          jsonb_build_object('papel', p_papel), jsonb_build_object('nome', split_part(p_email, '@', 1)), now(), now());
  if not p_ativo then
    update public.usuarios set ativo = false where id = v_id;
  end if;
  return v_id;
end $$;

-- Assume a identidade de um usuário (como o PostgREST faz com o JWT).
create or replace function pg_temp.logar(p_id uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_id::text, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

create or replace function pg_temp.anonimo() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end $$;

create or replace function pg_temp.sair() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

-- Deixa o carro "verificado" para testes que não tratam da verificação da venda:
-- laudo cautelar aprovado, sem histórico de repintura/reparo e consulta da placa
-- recente sem registros. Rodar como postgres (antes de logar ou depois de sair).
create or replace function pg_temp.carro_verificado(p_veiculo uuid) returns void language plpgsql as $$
declare
  v_placa text;
  v_usuario uuid;
begin
  select placa into v_placa from public.veiculos where id = p_veiculo;
  if v_placa is null then
    v_placa := 'TST' || floor(random() * 10)::int || chr(65 + floor(random() * 26)::int) || lpad(floor(random() * 100)::int::text, 2, '0');
    update public.veiculos set placa = v_placa where id = p_veiculo;
  end if;
  update public.veiculos set laudo_cautelar = true, laudo_resultado = 'aprovado' where id = p_veiculo;
  delete from public.veiculo_historico where veiculo_id = p_veiculo and tipo in ('pintura', 'reparo', 'sinistro');
  update public.veiculo_historico set km = null where veiculo_id = p_veiculo;
  select id into v_usuario from public.usuarios order by criado_em limit 1;
  insert into public.consultas_veiculares (placa, provedor, simulado, status, expira_em, usuario_id, verificacoes, selo)
  values (v_placa, 'Teste', true, 'encontrado', now() + interval '7 days', v_usuario,
          '{"leilao": {"estado": "nada_encontrado"}, "roubo_furto": {"estado": "nada_encontrado"}, "gravame": {"estado": "nada_encontrado"}}', 'verde');
end $$;
